{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "CanaryConfig": {
    "CheckIntervalSeconds": 60,
    "Targets": [
      {
        "Name": "Google",
        "Url": "https://google.com"
      },
      {
        "Name": "Microsoft",
        "Url": "https://microsoft.com"
      },
      {
        "Name": "Local-DB-Check",
        "Url": "http://health_db:5432"
      }
    ]
  }
}